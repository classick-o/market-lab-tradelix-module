{
  "name": "market-lab",
  "private": true,
  "version": "0.1.0",
  "description": "Tradelix Market Lab — learn trading by making decisions in a simulated market.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:build": "tsx packages/academy/scripts/build-content.ts",
    "predev": "npm run content:build",
    "prebuild": "npm run content:build",
    "pretest": "npm run content:build",
    "dev": "npm run dev -w @market-lab/standalone",
    "build": "npm run build -w @market-lab/standalone",
    "preview": "npm run preview -w @market-lab/standalone",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "content:generate": "tsx packages/missions/scripts/generate-data.ts",
    "content:inspect": "tsx packages/missions/scripts/inspect.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
